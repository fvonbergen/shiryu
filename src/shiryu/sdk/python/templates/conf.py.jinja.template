# noqa: D100
# Configuration file for the Sphinx documentation builder.
#
# For the full list of built-in configuration values, see the documentation:
# https://www.sphinx-doc.org/en/master/usage/configuration.html

{% if append_syspath -%}
# -- Path setup --------------------------------------------------------------

import os
import sys
sys.path.insert(0, {{ module_path }})

{% endif -%}
# -- Project information -----------------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/configuration.html#project-information

project = {{ project | repr }}  # fmt: skip
copyright = {{ copyright | repr }}  # noqa: A001
author = {{ author | repr }}

{% if not version and not release -%}
from importlib.metadata import version as _version  # noqa: E402

release = _version({{ project | repr }})  # fmt: skip
version = '.'.join(release.split('.')[:2])  # fmt: skip
{%- else %}
{%- if version %}
version = {{ version | repr }}  # fmt: skip
{%- endif %}
{%- if release %}
release = {{ release | repr }}  # fmt: skip
{%- endif %}
{%- endif %}

# -- General configuration ---------------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/configuration.html#general-configuration

extensions = [{% if extensions %}
{%- for ext in extensions %}
    '{{ ext }}',
{%- endfor %}
{% endif %}]  # fmt: skip

templates_path = ['{{ dot }}templates']  # fmt: skip
exclude_patterns = [{{ exclude_patterns }}]

{% if suffix != '.rst' -%}
source_suffix = {{ suffix | repr }}  # fmt: skip
{% endif -%}

{% if root_doc != 'index' -%}
root_doc = {{ root_doc | repr }}  # fmt: skip
{% endif -%}

{% if language -%}
language = {{ language | repr }}  # fmt: skip
{%- endif %}

# -- Options for HTML output -------------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/configuration.html#options-for-html-output

# html_theme = 'alabaster'
# TODO: check that sphinx_rtd_theme is installed
html_theme = 'sphinx_rtd_theme'  # fmt: skip
html_static_path = ['{{ dot }}static']  # fmt: skip
{% if 'sphinx.ext.intersphinx' in extensions %}
# -- Options for intersphinx extension ---------------------------------------
# https://www.sphinx-doc.org/en/master/usage/extensions/intersphinx.html#configuration

intersphinx_mapping = {
    'python': ('https://docs.python.org/3', None),
}  # fmt: skip
{% endif -%}
{% if 'sphinx.ext.autodoc' in extensions %}
# -- Options for autodoc extension ----------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/extensions/autodoc.html#configuration

{% if 'sphinx_autodoc_typehints' in extensions %}
# sphinx-autodoc-typehints settings.
typehints_defaults = 'comma'  # fmt: skip
{% endif -%}
{% endif %}
{% if 'sphinx.ext.todo' in extensions %}
# -- Options for todo extension ----------------------------------------------
# https://www.sphinx-doc.org/en/master/usage/extensions/todo.html#configuration

todo_include_todos = True
{% endif %}
