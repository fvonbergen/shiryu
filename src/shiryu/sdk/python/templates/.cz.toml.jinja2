[tool.commitizen]
version_provider = "uv"
version_scheme = "semver"
tag_format = "v$version"
legacy_tag_formats = ["$version"]
update_changelog_on_bump = true
major_version_zero = true
change_type_order = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
pre_bump_hooks = [
  # "## v1.2.0 (2026-10-20)" -> "## [1.2.0] - 2026-10-20"
  '''sed -i -E 's/^## v([0-9][^ ]*) \(([0-9-]{10})\)$/## [\1] - \2/' CHANGELOG.md''',
  # Update [Unreleased] and add new link at the bottom
  '''sed -i -E "s#^\[Unreleased\]: (.*)/compare/.*#[Unreleased]: \1/compare/$CZ_PRE_NEW_TAG_VERSION...HEAD\n[$CZ_PRE_NEW_VERSION]: \1/compare/$CZ_PRE_CURRENT_TAG_VERSION...$CZ_PRE_NEW_TAG_VERSION#" CHANGELOG.md''',
]

# Maps Conventional Commit types directly to Keep a Changelog headings
[tool.commitizen.change_type_map]
feat = "Added"
fix = "Fixed"
perf = "Changed"
refactor = "Changed"
style = "Changed"
deprecate = "Deprecated"
remove = "Removed"
sec = "Security"
docs = "Documentation"