[project]
name = "{{ project_name }}"
version = "{{ project_version }}"
description = ""
readme = "{{ readme_file_name }}"
license = "{{ license }}"
license-files = ["{{ license_file_name }}"]
authors = [
  {% for project_author in project_authors|sort(attribute="name") %}
  { name = "{{ project_author.name }}", email = "{{ project_author.email }}" },
  {% endfor %}
]
maintainers = [
  {% for project_author in project_authors|sort(attribute="name") %}
  { name = "{{ project_author.name }}", email = "{{ project_author.email }}" },
  {% endfor %}
]
keywords = []
requires-python = ">={{ requires_python }}"
# NOTE: Keep these aligned with [project].requires-python; update if minimum Python changes.
classifiers = [
  "Operating System :: OS Independent",
  "Programming Language :: Python",
  {% for major, group in python_versions | sort(attribute='release') | groupby('release.0') %}
  "Programming Language :: Python :: {{ major }}",
  {% for version in group | sort(attribute='release') %}
  "Programming Language :: Python :: {{ version }}",
  {% endfor %}
  {% endfor %}
  "Typing :: Typed",
]
dependencies = []

[project.urls]
# Homepage = ""
# Documentation = ""
# Repository = ""
# Issues = ""
# Changelog = ""
# Release Notes = ""
# Community = ""

# Dependencies that will be installed for the specific module call.
[dependency-groups]
{% for dependency_group, specifiers in dependency_groups_specifiers|dictsort %}
{{ dependency_group }} = [{% if specifiers|length !=0 %}"{{ specifiers|list|sort|join('", "') }}"{% endif %}]
{% endfor %}

[build-system]
requires = ["hatchling=={{ hatchling_version }}"]
build-backend = "hatchling.build"
